<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Scope — <%= proj.address %></title>
  <link rel="stylesheet" href="/css/app.css?v=5">
  <style>
    .sc-wrap { max-width:1120px; margin:1.4rem auto; padding:0 1rem; }
    .sc-head { display:flex; align-items:center; gap:.8rem; margin-bottom:.8rem; }
    .sc-head h1 { margin:0; font-size:1.2rem; letter-spacing:-.01em; }
    .sc-head .meta { color:var(--muted); font-size:.8rem; }
    .sc-card { background:var(--surface); border:1px solid var(--border); border-radius:14px; padding:1.1rem 1.4rem 1.3rem; }
  </style>
</head>
<body>
<%- include('_nav', { active: '' }) %>
<main class="sc-wrap">
  <div class="sc-head">
    <h1>Scope &amp; Selections</h1>
    <span class="meta"><a href="/projects/<%= proj.id %>"><%= proj.address %></a></span>
  </div>
  <div class="sc-card"><div id="scopeRoot"></div></div>
</main>
<script src="/js/scope-panel.js?v=8"></script>
<script>
  // Same shared component the project page embeds — this page is just a wide host.
  ScopePanel.init(document.getElementById('scopeRoot'), <%= proj.id %>, { title: '' });
</script>
</body>
</html>
