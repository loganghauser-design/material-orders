<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Warranty — Buildoly Office</title>
  <link rel="stylesheet" href="/css/app.css?v=3">
  <style>
    .wc { background:var(--surface); border:1px solid var(--border); border-radius:12px; padding:1rem 1.1rem; margin-bottom:1rem; }
    .wc.resolved { opacity:.6; }
    .wc-top { display:flex; align-items:flex-start; justify-content:space-between; gap:1rem; flex-wrap:wrap; }
    .wc-who { font-weight:800; font-size:1.05rem; }
    .wc-proj { color:var(--muted); font-size:.86rem; margin-top:.15rem; }
    .wc-proj a { color:var(--accent); }
    .wc-unmatched { color:#b45309; font-style:italic; }
    .wc-rooms { margin:.55rem 0 .2rem; }
    .room-pill { display:inline-block; background:#eef2ff; color:#3730a3; font-size:.74rem; font-weight:700; padding:2px 9px; border-radius:10px; margin:0 .35rem .35rem 0; }
    .wc-desc { font-size:.95rem; line-height:1.5; white-space:pre-wrap; word-break:break-word; margin:.3rem 0; }
    .wc-contact { font-size:.88rem; margin-top:.3rem; }
    .wc-contact a { color:var(--accent); }
    .wc-photos { display:flex; flex-wrap:wrap; gap:.5rem; margin:.6rem 0 .2rem; }
    .wc-photos a img { width:96px; height:96px; object-fit:cover; border-radius:9px; border:1px solid var(--border); }
    .wc-actions { margin-top:.7rem; display:flex; gap:.6rem; align-items:center; flex-wrap:wrap; }
    .wc-actions select { padding:.4rem .6rem; border:1px solid var(--border); border-radius:8px; background:var(--surface); font-size:.86rem; }
    .badge { padding:2px 11px; border-radius:11px; font-size:.74rem; font-weight:700; white-space:nowrap; }
    .badge-open { background:#fee2e2; color:#b91c1c; }
    .badge-progress { background:#fef3c7; color:#92400e; }
    .badge-resolved { background:#dcfce7; color:#166534; }
    .sec-divider { font-size:.8rem; text-transform:uppercase; letter-spacing:.04em; color:var(--muted); font-weight:700; margin:1.5rem 0 .7rem; }
    .navbadge { background:#cc2222; color:#fff; border-radius:9px; padding:0 6px; font-size:.72rem; }
    .superhead { display:flex; align-items:center; justify-content:space-between; padding:1rem 1.2rem; background:#111; color:#fff; }
    .superhead .brand { font-weight:800; font-size:1.1rem; }
    .superhead a { color:#fff; text-decoration:none; font-size:.9rem; }
  </style>
</head>
<body>
<% if (isSuper) { %>
<div class="superhead">
  <span class="brand">Buildoly — Warranty</span>
  <span><a href="/my">← My projects</a> &nbsp;·&nbsp; <a href="/logout">Sign out</a></span>
</div>
<% } else { %>
<%- include('_nav', { active: 'warranty' }) %>
<% } %>

<div class="container">
  <div class="page-header"><h1>Warranty</h1></div>
  <% var _wl = (typeof welcomes !== 'undefined' && welcomes) || []; %>
  <% var _showWrap = _wl.length && typeof isSuper !== 'undefined' && !isSuper; %>
  <div style="display:flex;gap:.4rem;margin-bottom:1.1rem">
    <button type="button" class="wtab on" data-wtab="claims" onclick="wTab('claims')" style="font:inherit;font-size:.86rem;font-weight:700;padding:.45rem .95rem;border:1px solid var(--border);border-radius:9px;background:#111318;color:#fff;cursor:pointer">🔧 Claims</button>
    <% if (_showWrap) { %><button type="button" class="wtab" data-wtab="wrapup" onclick="wTab('wrapup')" style="font:inherit;font-size:.86rem;font-weight:700;padding:.45rem .95rem;border:1px solid var(--border);border-radius:9px;background:var(--surface);color:var(--muted);cursor:pointer">🎁 Wrap Up</button><% } %>
  </div>

  <div class="wpanel" data-wpanel="wrapup" style="display:none">
  <% if (_showWrap) { %>
  <div style="background:var(--surface);border:1px solid var(--border);border-radius:13px;padding:.85rem 1.1rem;margin-bottom:1.4rem;max-width:none">
    <div style="display:flex;align-items:baseline;gap:.6rem;margin-bottom:.6rem">
      <strong style="font-size:.95rem">🛡 Warranty welcome email</strong>
      <span style="font-size:.78rem;color:var(--muted)">type the project address — it pulls the record and autofills; the button drafts the email in Gmail for your review</span>
    </div>
    <div style="display:flex;align-items:center;gap:.55rem;flex-wrap:wrap">
      <input id="wwProj" list="wwProjList" type="text" placeholder="Type the project address…" oninput="wwPick()" onchange="wwPick()" style="font:inherit;font-size:.85rem;padding:.42rem .55rem;border:1px solid var(--border);border-radius:8px;background:var(--bg);color:var(--text);min-width:230px">
      <datalist id="wwProjList">
        <% _wl.forEach(function (w) { %><option value="<%= w.address %>"></option><% }) %>
      </datalist>
      <input id="wwName" type="text" placeholder="Client name(s)" style="font:inherit;font-size:.85rem;padding:.42rem .55rem;border:1px solid var(--border);border-radius:8px;background:var(--bg);color:var(--text);min-width:180px">
      <input id="wwEmail" type="text" placeholder="client@email.com (comma for two)" style="font:inherit;font-size:.85rem;padding:.42rem .55rem;border:1px solid var(--border);border-radius:8px;background:var(--bg);color:var(--text);min-width:230px;flex:1">
      <label style="display:flex;flex-direction:column;gap:2px;font-size:.68rem;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.04em">Warranty start (final inspection date)
        <input id="wwStart" type="date" style="font:inherit;font-size:.85rem;font-weight:400;text-transform:none;letter-spacing:0;padding:.34rem .55rem;border:1px solid var(--border);border-radius:8px;background:var(--bg);color:var(--text)">
      </label>
      <button type="button" class="btn btn-primary btn-sm" id="wwSendBtn" onclick="wwSendForm()">📝 Draft email for review</button>
    </div>
    <div id="wwNote" style="font-size:.76rem;color:var(--muted);margin-top:.4rem"></div>
    <div style="margin-top:.7rem;border-top:1px solid var(--border);padding-top:.5rem">
      <div style="font-size:.72rem;font-weight:800;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);margin-bottom:.3rem">Drafted tracker · <%= _wl.filter(function(w){return w.warranty_welcomed_at;}).length %> of <%= _wl.length %></div>
      <div style="display:flex;gap:.4rem;flex-wrap:wrap">
        <% _wl.forEach(function (w) { %>
          <span id="wwtrack<%= w.id %>" style="font-size:.74rem;padding:.16rem .55rem;border-radius:8px;<%= w.warranty_welcomed_at ? 'background:#e7f6ec;color:#176b3a;font-weight:700' : 'background:var(--bg);color:var(--muted);border:1px dashed var(--border)' %>"><%= w.address %><%= w.warranty_welcomed_at ? ' ✓ ' + new Date(w.warranty_welcomed_at).toLocaleDateString('en-US',{month:'short',day:'numeric'}) : '' %></span>
        <% }) %>
      </div>
    </div>
  </div>
  <script>
  const WW_DATA = <%- JSON.stringify(_wl.map(function (w) { return { id: w.id, address: w.address, name: w.client_name || '', email: w.client_email || '', start: w.suggest_start ? new Date(w.suggest_start).toISOString().slice(0,10) : '', sent: w.warranty_welcomed_at ? new Date(w.warranty_welcomed_at).toLocaleDateString('en-US',{month:'short',day:'numeric'}) : '' }; })) %>;
  let WW_CUR = null;
  function wwPick() {
    const q = document.getElementById('wwProj').value.trim().toLowerCase();
    const note = document.getElementById('wwNote');
    WW_CUR = null;
    if (q.length < 3) { note.textContent = ''; return; }
    const hits = WW_DATA.filter(w => w.address.toLowerCase().includes(q));
    if (!hits.length) { note.textContent = 'No warranty project matches that.'; return; }
    if (hits.length > 1) { note.textContent = hits.length + ' matches — keep typing: ' + hits.slice(0, 4).map(w => w.address).join(' · '); return; }
    WW_CUR = hits[0];
    document.getElementById('wwName').value = WW_CUR.name;
    document.getElementById('wwEmail').value = WW_CUR.email;
    document.getElementById('wwStart').value = WW_CUR.start;
    note.textContent = '→ ' + WW_CUR.address + (WW_CUR.sent ? '  ·  already drafted ' + WW_CUR.sent + ' — drafting again makes a second copy' : '');
  }
  async function wwSendForm() {
    if (!WW_CUR) { alert('Type the project address until exactly one matches.'); return; }
    const name = document.getElementById('wwName').value.trim();
    const email = document.getElementById('wwEmail').value.trim();
    if (!email) { alert("Type the client's email."); return; }
    const wstart = document.getElementById('wwStart').value;
    if (!wstart) { alert('Pick the warranty start date (the final inspection date).'); return; }
    if (!confirm('Draft the warranty email for ' + email + ' (' + WW_CUR.address + ')? You review + send it from Gmail.')) return;
    const btn = document.getElementById('wwSendBtn');
    btn.disabled = true; btn.textContent = 'Drafting…';
    try {
      const r = await fetch('/projects/' + WW_CUR.id + '/warranty-welcome', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ client_name: name, client_email: email, warranty_start: wstart }) });
      const d = await r.json();
      if (!d.ok) { alert(d.error || 'Draft failed'); return; }
      const t = document.getElementById('wwtrack' + WW_CUR.id);
      if (t) { t.style.cssText = 'font-size:.74rem;padding:.16rem .55rem;border-radius:8px;background:#e7f6ec;color:#176b3a;font-weight:700'; t.textContent = t.textContent.replace(/ ✓.*$/,'') + ' ✓ just now'; }
      WW_CUR.sent = 'just now'; WW_CUR.name = name; WW_CUR.email = email;
      document.getElementById('wwNote').textContent = '📝 Draft created for ' + d.draftedFor + ' — open Gmail Drafts to review + send.';
    } catch (e) { alert('Draft failed: ' + e.message); }
    finally { btn.disabled = false; btn.textContent = '📝 Draft email for review'; }
  }
    </script>
  <% } %>
  </div><!-- /wrapup -->

  <div class="wpanel" data-wpanel="claims">
  <p style="color:var(--muted);font-size:.9rem;margin-bottom:1.25rem;max-width:720px">
    Submitted by clients through the public warranty link. Share the link from Settings.
  </p>
  <% const open = claims.filter(c => c.status !== 'Resolved'); const done = claims.filter(c => c.status === 'Resolved'); %>
  <% if (!claims.length) { %>
    <div class="wc" style="color:var(--muted)">No warranty claims yet. When a client submits one through the warranty link, it shows up here.</div>
  <% } %>

  <% function badgeClass(s){ if(s==='Resolved')return 'resolved'; if(s==='In Progress')return 'progress'; return 'open'; } %>

  <% function renderClaim(c) { %>
    <div class="wc <%= c.status === 'Resolved' ? 'resolved' : '' %>" id="wc_<%= c.id %>">
      <div class="wc-top">
        <div style="min-width:0">
          <div class="wc-who">🏠 <%= c.client_name || 'Client' %></div>
          <div class="wc-proj">
            <% if (c.project_id && c.matched_address) { %>
              <a href="/projects/<%= c.project_id %>"><%= c.matched_address %></a>
            <% } else { %>
              <span class="wc-unmatched">Typed: <%= c.project_address || '—' %> (no project match)</span>
            <% } %>
            · <%= new Date(c.created_at).toLocaleString('en-US', { month:'short', day:'numeric', hour:'numeric', minute:'2-digit' }) %>
          </div>
        </div>
        <span class="badge badge-<%= badgeClass(c.status) %>"><%= (c.status || 'Open').toUpperCase() %></span>
      </div>

      <% if (c.rooms) { %><div class="wc-rooms"><% c.rooms.split(',').map(r => r.trim()).filter(Boolean).forEach(r => { %><span class="room-pill"><%= r %></span><% }) %></div><% } %>
      <% if (c.description) { %><div class="wc-desc"><%= c.description %></div><% } %>
      <% if (c.client_contact) { %><div class="wc-contact">📞 <a href="tel:<%= c.client_contact.replace(/[^0-9+]/g,'') %>"><%= c.client_contact %></a></div><% } %>

      <% const pics = photosByClaim[c.id] || []; %>
      <% if (pics.length) { %>
        <div class="wc-photos">
          <% pics.forEach(pid => { %><a href="/warranty-claims/<%= c.id %>/photo/<%= pid %>" target="_blank"><img src="/warranty-claims/<%= c.id %>/photo/<%= pid %>" alt="photo"></a><% }) %>
        </div>
      <% } %>

      <div class="wc-actions">
        <label style="font-size:.82rem;color:var(--muted)">Status:</label>
        <select onchange="setStatus(<%= c.id %>, this.value)">
          <% ['Open','In Progress','Resolved'].forEach(s => { %><option value="<%= s %>" <%= c.status === s ? 'selected' : '' %>><%= s %></option><% }) %>
        </select>
        <button class="btn btn-ghost btn-sm" style="color:#cc2222" onclick="del(<%= c.id %>)">Delete</button>
      </div>
    </div>
  <% } %>

  <% if (open.length) { %>
    <div class="sec-divider">🔴 Open (<%= open.length %>)</div>
    <% open.forEach(c => renderClaim(c)) %>
  <% } %>
  <% if (done.length) { %>
    <div class="sec-divider">✓ Resolved (<%= done.length %>)</div>
    <% done.forEach(c => renderClaim(c)) %>
  <% } %>
  </div><!-- /claims -->
</div>

<script>
function wTab(t) {
  document.querySelectorAll('.wpanel').forEach(p => p.style.display = p.dataset.wpanel === t ? 'block' : 'none');
  document.querySelectorAll('.wtab').forEach(b => {
    const on = b.dataset.wtab === t;
    b.style.background = on ? '#111318' : 'var(--surface)';
    b.style.color = on ? '#fff' : 'var(--muted)';
  });
}
document.addEventListener('DOMContentLoaded', () => {
  if (new URLSearchParams(location.search).get('tab') === 'wrapup') wTab('wrapup');
});
</script>

<script>
async function setStatus(id, status) {
  const r = await fetch('/warranty-claims/' + id + '/status', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ status }) });
  const d = await r.json();
  if (d.ok) location.reload(); else alert('Could not update.');
}
async function del(id) {
  if (!confirm('Delete this warranty claim?')) return;
  const r = await fetch('/warranty-claims/' + id + '/delete', { method:'POST', headers:{'Content-Type':'application/json'}, body:'{}' });
  const d = await r.json();
  if (d.ok) document.getElementById('wc_' + id).remove(); else alert('Could not delete.');
}
</script>
</body>
</html>
