<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Model Templates — Buildoly Office</title>
  <link rel="stylesheet" href="/css/app.css?v=5">
  <style>
    .tp-wrap { max-width:1020px; margin:1.4rem auto; padding:0 1rem; }
    .tp-head { display:flex; align-items:center; gap:.8rem; margin-bottom:.4rem; }
    .tp-head h1 { margin:0; font-size:1.2rem; letter-spacing:-.01em; }
    .tp-sub { color:var(--muted); font-size:.85rem; margin:0 0 1rem; max-width:760px; }
    .tp-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(300px,1fr)); gap:.8rem; }
    .tp-card { background:var(--surface); border:1px solid var(--border); border-radius:12px; padding:.95rem 1.1rem; display:flex; flex-direction:column; gap:.5rem; }
    .tp-card .nm { font-size:1.05rem; font-weight:800; display:flex; align-items:center; gap:.5rem; }
    .tp-card .meta { font-size:.76rem; color:var(--muted); }
    .tp-red { color:#dc2626; font-weight:700; }
    .tp-row { display:flex; align-items:center; gap:.5rem; font-size:.78rem; color:var(--muted); }
    .tp-row input[type=number] { width:52px; font:inherit; font-size:.78rem; padding:.2rem .35rem; border:1px solid var(--border); border-radius:6px; background:var(--bg); color:var(--text); }
    .tp-actions { display:flex; gap:.5rem; margin-top:.2rem; }
    .tp-btn { border:1px solid var(--border); background:var(--bg); border-radius:8px; padding:.4rem .8rem; font:inherit; font-size:.8rem; font-weight:700; color:var(--text); cursor:pointer; text-decoration:none; }
    .tp-btn.primary { background:#111; color:#fff; border-color:#111; }
    .tp-btn:hover { border-color:#4f8ef7; }
    #toast { position:fixed; bottom:16px; right:16px; background:#111; color:#fff; border-radius:8px; padding:.55rem .9rem; font-size:.8rem; opacity:0; transition:opacity .2s; pointer-events:none; z-index:50; }
    #toast.show { opacity:1; }
  </style>
</head>
<body>
<%- include('_nav', { active: 'templates' }) %>
<main class="tp-wrap">
  <div class="tp-head"><h1>Model Templates</h1></div>
  <p class="tp-sub">The baseline every new project inherits when its model is picked — products, quantities, exclusions.
  Edit a template here and every <strong>future</strong> project of that model gets the change; projects already created are never touched.</p>
  <div class="tp-grid">
    <% templates.forEach(function (t) { %>
    <div class="tp-card">
      <div class="nm"><%= t.name %><% if (t.name === 'MS') { %> <span class="meta">Studio</span><% } %></div>
      <div class="meta"><%= t.rows %> rows · <%= t.items %> items<% if (t.reds > 0) { %> · <span class="tp-red"><%= t.reds %> unpicked</span><% } %><% if (t.updated_at) { %> · updated <%= new Date(t.updated_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %><% } %></div>
      <div class="tp-row">
        Bathrooms
        <input type="number" min="0" max="9" value="<%= t.bathrooms == null ? '' : t.bathrooms %>" onchange="saveMeta(<%= t.id %>, this.value, document.getElementById('pan<%= t.id %>').checked)" title="Bathroom sections shown on the scope follow this. Blank = show all.">
        <label style="display:inline-flex;align-items:center;gap:.3rem;cursor:pointer">
          <input type="checkbox" id="pan<%= t.id %>" <%= t.pantry ? 'checked' : '' %> onchange="saveMeta(<%= t.id %>, this.parentElement.parentElement.querySelector('input[type=number]').value, this.checked)"> Pantry
        </label>
      </div>
      <div class="tp-actions">
        <a class="tp-btn primary" href="/templates/<%= t.id %>/edit">✎ Edit template</a>
        <% if (t.reds > 0) { %><a class="tp-btn" href="/templates/<%= t.id %>/edit?nys=1" title="Jump straight to the unpicked rows">🔴 Fix unpicked</a><% } %>
      </div>
    </div>
    <% }) %>
  </div>
</main>
<div id="toast"></div>
<script>
let toastT;
function toast(msg, bad) {
  const t = document.getElementById('toast');
  t.textContent = msg; t.style.background = bad ? '#7f1d1d' : '#111';
  t.classList.add('show'); clearTimeout(toastT); toastT = setTimeout(() => t.classList.remove('show'), 2200);
}
async function saveMeta(id, bathrooms, pantry) {
  try {
    const r = await fetch('/templates/' + id + '/meta', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ bathrooms: bathrooms, pantry: !!pantry }) });
    const d = await r.json();
    if (d.ok) toast('Saved'); else toast(d.error || 'Could not save', true);
  } catch (e) { toast('Could not save', true); }
}
</script>
</body>
</html>
