<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Bid Comparison — Buildoly Office</title>
  <link rel="stylesheet" href="/css/app.css?v=5">
  <style>
    /* Same tab strip as the Subs page (those styles are local to subs.ejs) */
    .subtabs { display:flex; gap:.35rem; flex-wrap:wrap; border-bottom:2px solid var(--border); margin-bottom:1.1rem; }
    .subtab { font:inherit; font-size:.92rem; font-weight:700; color:var(--muted); background:none; border:none; border-bottom:3px solid transparent; padding:.55rem .9rem; margin-bottom:-2px; cursor:pointer; white-space:nowrap; text-decoration:none; }
    .subtab:hover { color:var(--text); background:var(--bg); border-radius:9px 9px 0 0; }
    .subtab.on { color:var(--text); border-bottom-color:#111; }

    .bc-tools { background:var(--surface); border:1px solid var(--border); border-radius:12px; padding:.7rem .85rem; margin-bottom:1rem; }
    .bc-line { display:flex; gap:.5rem; align-items:center; flex-wrap:wrap; }
    .bc-line + .bc-line { margin-top:.55rem; padding-top:.55rem; border-top:1px solid var(--border); }
    .bc-lab { font-size:.7rem; font-weight:800; color:var(--muted); text-transform:uppercase; letter-spacing:.04em; width:58px; flex:none; }
    .bc-chip { padding:.3rem .8rem; border:1px solid var(--border); border-radius:999px; background:var(--bg); font-size:.83rem; font-weight:600; cursor:pointer; color:var(--text); white-space:nowrap; user-select:none; display:inline-flex; align-items:center; gap:.35rem; }
    .bc-chip:hover { border-color:#4f8ef7; }
    .bc-chip.on { background:#111; color:#fff; border-color:#111; }
    .bc-chip .dot { width:9px; height:9px; border-radius:3px; display:inline-block; }
    .bc-chip .n { font-size:.72rem; opacity:.75; font-weight:700; }
    .bc-search { flex:1; min-width:200px; padding:.4rem .7rem; border:1px solid var(--border); border-radius:9px; background:var(--bg); color:var(--text); font-size:.88rem; font-family:inherit; }
    .bc-sel { padding:.4rem .6rem; border:1px solid var(--border); border-radius:9px; background:var(--bg); color:var(--text); font-size:.85rem; font-family:inherit; }
    .bc-clear { background:none; border:none; color:#2563eb; font-size:.82rem; font-weight:600; cursor:pointer; padding:.2rem .3rem; }

    .bc-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(320px,1fr)); gap:.8rem; }
    .bc-card { background:var(--surface); border:1px solid var(--border); border-radius:12px; padding:.75rem .9rem; }
    .bc-head { display:flex; align-items:baseline; gap:.45rem; margin-bottom:.5rem; }
    .bc-trade { font-size:.92rem; font-weight:700; }
    .bc-n { margin-left:auto; font-size:.74rem; color:var(--muted); font-weight:600; }
    .bc-row { padding:.4rem 0 .3rem; font-size:.85rem; }
    .bc-rowtop { display:flex; align-items:baseline; gap:.5rem; margin-bottom:.22rem; }
    .bc-co { font-weight:600; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:var(--text); text-decoration:none; }
    .bc-co:hover { text-decoration:underline; }
    .bc-amt { margin-left:auto; font-weight:700; font-variant-numeric:tabular-nums; white-space:nowrap; }
    .bc-meta { font-size:.72rem; color:var(--muted); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    /* Bar: left-anchored, rounded at the data end, on a recessive track */
    .bc-track { height:9px; background:var(--bg); border-radius:5px; position:relative; overflow:hidden; }
    .bc-fill { height:100%; border-radius:3px 5px 5px 3px; min-width:3px; }
    .bc-plot { position:relative; }
    .bc-avg { position:absolute; top:0; bottom:.3rem; width:0; border-left:1px dashed var(--muted); opacity:.55; pointer-events:none; }
    .bc-stats { display:flex; gap:.5rem; flex-wrap:wrap; font-size:.72rem; color:var(--muted); margin-top:.45rem; padding-top:.4rem; border-top:1px dashed var(--border); }
    .bc-scale { font-size:.68rem; color:var(--muted); margin-top:.15rem; }
    .bc-empty { color:var(--muted); background:var(--surface); border:1px solid var(--border); border-radius:12px; padding:2rem; text-align:center; }
    /* Whole-project GC bids — their own section, grouped by job. A $200k build bid
       has no business sharing a scale with a $3k tile bid. */
    .gc-sec { margin-bottom:1.4rem; }
    .gc-h { display:flex; align-items:baseline; gap:.5rem; margin:0 0 .6rem; }
    .gc-h h2 { margin:0; font-size:1rem; }
    .gc-h .sub { font-size:.78rem; color:var(--muted); }
    .gc-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(360px,1fr)); gap:.8rem; }
    .gc-card { background:var(--surface); border:1px solid var(--border); border-radius:12px; overflow:hidden; }
    .gc-top { padding:.7rem .9rem .55rem; border-bottom:1px solid var(--border); background:var(--bg); }
    .gc-proj { font-size:.95rem; font-weight:700; }
    .gc-meta { font-size:.74rem; color:var(--muted); margin-top:.15rem; }
    .gc-body { padding:.6rem .9rem .8rem; }
    .gc-row { padding:.42rem 0 .3rem; border-top:1px solid var(--border); }
    .gc-row:first-child { border-top:none; }
    .gc-line { display:flex; align-items:baseline; gap:.5rem; margin-bottom:.25rem; }
    .gc-co { font-weight:600; font-size:.88rem; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:var(--text); text-decoration:none; }
    .gc-co:hover { text-decoration:underline; }
    .gc-amt { margin-left:auto; font-weight:700; font-size:.92rem; font-variant-numeric:tabular-nums; white-space:nowrap; }
    .gc-track { height:10px; background:var(--bg); border-radius:5px; overflow:hidden; }
    .gc-fill { height:100%; border-radius:3px 5px 5px 3px; min-width:4px; }
    .gc-rank { font-size:.64rem; font-weight:800; padding:1px 6px; border-radius:999px; white-space:nowrap; }
    .gc-low { background:#e7f6ec; color:#176b3a; } .gc-high { background:#fdeaea; color:#b42323; }
    .gc-stats { display:flex; gap:.8rem; flex-wrap:wrap; font-size:.72rem; color:var(--muted); margin-top:.55rem; padding-top:.45rem; border-top:1px dashed var(--border); }
    .bc-sum { font-size:.84rem; color:var(--muted); margin-bottom:.7rem; }
  </style>
</head>
<body>
<%- include('_nav', { active: 'subs' }) %>

<div class="container">
  <div class="page-header" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem">
    <div>
      <h1 style="margin:0">GC &amp; Sub Database</h1>
      <div style="color:var(--muted);font-size:.88rem">Every bid on file, grouped by trade. Filters apply instantly — costs differ by market.</div>
    </div>
    <div style="display:flex;gap:.5rem;align-items:center;flex-wrap:wrap">
      <button type="button" id="rescanBtn" class="btn btn-ghost btn-sm" onclick="rescanBids(this)" title="Re-read recent replies for bids the ingester missed — including bids typed in the email body">🔄 Re-scan inbox for missed bids</button>
      <a href="/subs/cost-comparison.xlsx" class="btn btn-ghost btn-sm">⬇ Export</a>
    </div>
  </div>
  <div id="rescanOut" style="display:none;font-size:.85rem;margin-bottom:.8rem;padding:.6rem .8rem;border-radius:9px"></div>

  <div class="subtabs">
    <a class="subtab" href="/subs">🔧 Subcontractors</a>
    <a class="subtab" href="/subs">🏗 Outside GCs</a>
    <a class="subtab" href="/subs">🚩 Flagged</a>
    <span class="subtab on">💰 Bids</span>
  </div>

  <div class="bc-tools">
    <div class="bc-line">
      <input type="search" id="q" class="bc-search" placeholder="Search a company, project, trade…" oninput="draw()">
      <select id="sort" class="bc-sel" onchange="draw()">
        <option value="low">Cheapest first</option>
        <option value="high">Most expensive first</option>
        <option value="spread">Widest spread first</option>
        <option value="count">Most bids first</option>
        <option value="trade">Trade A–Z</option>
      </select>
      <button type="button" class="bc-clear" onclick="clearAll()">Clear filters</button>
    </div>
    <div class="bc-line"><span class="bc-lab">County</span><span id="ctyChips" style="display:flex;gap:.4rem;flex-wrap:wrap"></span></div>
    <div class="bc-line"><span class="bc-lab">Trade</span><span id="trdChips" style="display:flex;gap:.4rem;flex-wrap:wrap"></span></div>
  </div>

  <div class="bc-sum" id="summary"></div>
  <div id="gcOut"></div>
  <div id="out"></div>
</div>

<script>
const BIDS = <%- JSON.stringify(bids || []).replace(/</g, '\\u003c') %>;
const COUNTIES = <%- JSON.stringify(counties || []).replace(/</g, '\\u003c') %>;
const TRADES = <%- JSON.stringify(trades || []).replace(/</g, '\\u003c') %>;
// Categorical hues in fixed order, keyed to the county's position in the full list —
// a bar keeps its colour no matter which filters are on.
const HUES = ['#2a78d6', '#eb6834', '#1baf7a', '#eda100', '#e87ba4', '#008300', '#4a3aa7'];
const hueFor = c => { const i = COUNTIES.indexOf(c); return (i >= 0 && i < HUES.length) ? HUES[i] : '#8a8a80'; };
const esc = s => String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
const money = n => '$' + Number(n).toLocaleString('en-US', { maximumFractionDigits: 0 });

// Multi-select: empty set = show everything.
const selCty = new Set(<%- JSON.stringify(initCounty ? [initCounty] : []) %>);
const selTrd = new Set(<%- JSON.stringify(initTrade ? [initTrade] : []) %>);

function chips() {
  document.getElementById('ctyChips').innerHTML = COUNTIES.map(c =>
    '<span class="bc-chip ' + (selCty.has(c) ? 'on' : '') + '" onclick="tog(\'cty\',' + JSON.stringify(c).replace(/"/g, '&quot;') + ')">'
    + '<span class="dot" style="background:' + hueFor(c) + '"></span>' + esc(c)
    + '<span class="n">' + BIDS.filter(b => b.county === c).length + '</span></span>').join('');
  document.getElementById('trdChips').innerHTML = TRADES.map(t =>
    '<span class="bc-chip ' + (selTrd.has(t) ? 'on' : '') + '" onclick="tog(\'trd\',' + JSON.stringify(t).replace(/"/g, '&quot;') + ')">'
    + esc(t) + '<span class="n">' + BIDS.filter(b => b.trade === t).length + '</span></span>').join('');
}
function tog(kind, val) {
  const s = kind === 'cty' ? selCty : selTrd;
  if (s.has(val)) s.delete(val); else s.add(val);
  chips(); draw();
}
function clearAll() {
  selCty.clear(); selTrd.clear();
  document.getElementById('q').value = '';
  chips(); draw();
}
// Trades that mean "a whole build", not a scope of work.
const GC_TRADES = ['GC Bids (full ADU)', 'General Contractor'];

// Whole-project bids, grouped by the job they're for — that's the decision you're
// actually making: who builds Plumosa.
function drawGc(rows) {
  const host = document.getElementById('gcOut');
  if (!rows.length) { host.innerHTML = ''; return; }
  const byProj = {};
  rows.forEach(b => { const k = b.project || 'Unassigned project'; (byProj[k] = byProj[k] || []).push(b); });
  // Most-bid job first, so the live decision floats to the top.
  const projects = Object.keys(byProj).sort((a, b) => byProj[b].length - byProj[a].length || a.localeCompare(b));
  const cards = projects.map(p => {
    const list = byProj[p].slice().sort((a, b) => a.amount - b.amount);
    const amts = list.map(b => b.amount).filter(n => n > 0);
    const lo = Math.min.apply(null, amts), hi = Math.max.apply(null, amts);
    const avg = Math.round(amts.reduce((x, y) => x + y, 0) / amts.length);
    const bars = list.map((b, i) => {
      const pct = hi > 0 ? Math.max(4, Math.round(b.amount / hi * 100)) : 0;
      const tag = (list.length > 1 && i === 0) ? '<span class="gc-rank gc-low">lowest</span>'
                : (list.length > 1 && i === list.length - 1) ? '<span class="gc-rank gc-high">highest</span>' : '';
      return '<div class="gc-row">'
        + '<div class="gc-line"><a class="gc-co" href="/subs/profile/' + b.subId + '" title="' + esc(b.company) + '">' + esc(b.company) + '</a>'
        + tag + '<span class="gc-amt">' + money(b.amount) + '</span></div>'
        + '<div class="gc-track" title="' + esc(b.company) + ' — ' + money(b.amount) + '"><div class="gc-fill" style="width:' + pct + '%;background:' + hueFor(b.county) + '"></div></div>'
        + (b.county ? '<div class="bc-meta" style="margin-top:.15rem">' + esc(b.county) + '</div>' : '')
        + '</div>';
    }).join('');
    const stats = amts.length > 1
      ? '<div class="gc-stats"><span>Low <strong style="color:#176b3a">' + money(lo) + '</strong></span>'
        + '<span>Avg <strong>' + money(avg) + '</strong></span>'
        + '<span>High <strong style="color:#b45309">' + money(hi) + '</strong></span>'
        + '<span>Spread <strong>' + money(hi - lo) + '</strong></span></div>' : '';
    return '<div class="gc-card"><div class="gc-top"><div class="gc-proj">' + esc(p) + '</div>'
      + '<div class="gc-meta">' + list.length + ' whole-project bid' + (list.length === 1 ? '' : 's')
      + (amts.length > 1 ? ' · ' + money(lo) + ' – ' + money(hi) : '') + '</div></div>'
      + '<div class="gc-body">' + bars + stats + '</div></div>';
  }).join('');
  host.innerHTML = '<div class="gc-sec"><div class="gc-h"><h2>🏗 Whole-project bids</h2>'
    + '<span class="sub">' + rows.length + ' bid' + (rows.length === 1 ? '' : 's') + ' across ' + projects.length + ' project' + (projects.length === 1 ? '' : 's')
    + ' — kept separate so they don\'t flatten the trade chart</span></div>'
    + '<div class="gc-grid">' + cards + '</div></div>';
}

function draw() {
  const q = (document.getElementById('q').value || '').trim().toLowerCase();
  const sort = document.getElementById('sort').value;
  let rows = BIDS.filter(b =>
    (!selCty.size || selCty.has(b.county)) &&
    (!selTrd.size || selTrd.has(b.trade)) &&
    (!q || (b.company + ' ' + b.project + ' ' + b.trade + ' ' + b.county).toLowerCase().includes(q)));

  // Whole-project GC bids are a different animal — pull them out so they don't
  // squash every trade bar against a $200k build number.
  const gcRows = rows.filter(b => GC_TRADES.indexOf(b.trade) !== -1);
  const tradeRows = rows.filter(b => GC_TRADES.indexOf(b.trade) === -1);
  drawGc(gcRows);
  rows = tradeRows;

  // Group into one card per trade
  const byTrade = {};
  rows.forEach(b => { (byTrade[b.trade] = byTrade[b.trade] || []).push(b); });
  let cards = Object.keys(byTrade).map(t => {
    const list = byTrade[t].slice().sort((a, b) => a.amount - b.amount);
    const amts = list.map(b => b.amount).filter(n => n > 0);
    const lo = amts.length ? Math.min.apply(null, amts) : 0;
    const hi = amts.length ? Math.max.apply(null, amts) : 0;
    const avg = amts.length ? Math.round(amts.reduce((x, y) => x + y, 0) / amts.length) : 0;
    return { trade: t, list, lo, hi, avg, spread: hi - lo };
  });
  if (sort === 'low') cards.sort((a, b) => a.lo - b.lo);
  else if (sort === 'high') cards.sort((a, b) => b.hi - a.hi);
  else if (sort === 'spread') cards.sort((a, b) => b.spread - a.spread);
  else if (sort === 'count') cards.sort((a, b) => b.list.length - a.list.length);
  else cards.sort((a, b) => a.trade.localeCompare(b.trade));

  const shown = [];
  rows.forEach(b => { if (shown.indexOf(b.county) < 0) shown.push(b.county); });
  shown.sort((a, b) => COUNTIES.indexOf(a) - COUNTIES.indexOf(b));

  document.getElementById('summary').innerHTML =
    '<strong style="color:var(--text)">' + rows.length + '</strong> bid' + (rows.length === 1 ? '' : 's')
    + ' · ' + cards.length + ' trade' + (cards.length === 1 ? '' : 's')
    + (shown.length > 1 ? ' · ' + shown.map(c => '<span style="display:inline-flex;align-items:center;gap:.25rem;margin-right:.5rem"><span style="width:9px;height:9px;border-radius:3px;background:' + hueFor(c) + ';display:inline-block"></span>' + esc(c) + '</span>').join('') : '')
    + ' · <span>bar length compares bids <em>within</em> a trade</span>';

  document.getElementById('out').innerHTML = !cards.length
    ? '<div class="bc-empty">No bids match these filters.</div>'
    : '<div class="bc-grid">' + cards.map(c => {
        const bars = c.list.map(b => {
          const pct = c.hi > 0 ? Math.max(2, Math.round(b.amount / c.hi * 100)) : 0;
          const meta = [b.county, b.project].filter(Boolean).join(' · ');
          return '<div class="bc-row">'
            + '<div class="bc-rowtop"><a class="bc-co" href="/subs/profile/' + b.subId + '" title="' + esc(b.company) + '">' + esc(b.company) + '</a>'
            + '<span class="bc-amt">' + money(b.amount) + '</span></div>'
            + '<div class="bc-track" title="' + esc(b.company) + ' — ' + money(b.amount) + (b.county ? ' · ' + esc(b.county) : '') + '">'
            + '<div class="bc-fill" style="width:' + pct + '%;background:' + hueFor(b.county) + '"></div></div>'
            + (meta ? '<div class="bc-meta" style="margin-top:.16rem">' + esc(meta) + '</div>' : '')
            + '</div>';
        }).join('');
        const avgLine = (c.list.length > 1 && c.hi > 0)
          ? '<div class="bc-avg" style="left:' + Math.round(c.avg / c.hi * 100) + '%" title="Average ' + money(c.avg) + '"></div>' : '';
        const stats = c.list.length > 1
          ? '<div class="bc-stats"><span>Low <strong style="color:#176b3a">' + money(c.lo) + '</strong></span>'
            + '<span>Avg <strong>' + money(c.avg) + '</strong></span>'
            + '<span>High <strong style="color:#8a5a00">' + money(c.hi) + '</strong></span>'
            + '<span>Spread <strong>' + money(c.spread) + '</strong></span></div>'
            + '<div class="bc-scale">Dashed line = average</div>' : '';
        return '<div class="bc-card"><div class="bc-head"><span class="bc-trade">' + esc(c.trade) + '</span>'
          + '<span class="bc-n">' + c.list.length + ' bid' + (c.list.length === 1 ? '' : 's') + '</span></div>'
          + '<div class="bc-plot">' + avgLine + bars + '</div>' + stats + '</div>';
      }).join('') + '</div>';
}
// Re-read recent replies through the current ingester — catches bids that were
// typed into the email body, or that arrived before the parser understood them.
async function rescanBids(btn) {
  const out = document.getElementById('rescanOut');
  btn.disabled = true; btn.textContent = 'Scanning inbox…';
  out.style.display = 'block';
  out.style.background = 'var(--bg)'; out.style.color = 'var(--muted)';
  out.textContent = 'Reading recent replies…';
  try {
    const r = await fetch('/subs/bids/rescan', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ days: 21 }) });
    const d = await r.json();
    if (!d.ok) { out.style.background = '#fdeaea'; out.style.color = '#b42323'; out.textContent = d.error || 'Scan failed'; return; }
    if (d.ingested) {
      out.style.background = '#e7f6ec'; out.style.color = '#176b3a';
      out.innerHTML = '✓ Found <strong>' + d.ingested + '</strong> missed bid' + (d.ingested === 1 ? '' : 's')
        + ' from ' + d.scanned + ' replies: ' + (d.found || []).map(esc).join(', ') + ' — reloading…';
      setTimeout(function () { location.reload(); }, 1800);
    } else {
      out.style.background = 'var(--bg)'; out.style.color = 'var(--muted)';
      out.textContent = 'Scanned ' + d.scanned + ' recent replies — no missed bids found.';
    }
  } catch (e) {
    out.style.background = '#fdeaea'; out.style.color = '#b42323'; out.textContent = 'Scan failed: ' + e.message;
  } finally { btn.disabled = false; btn.textContent = '🔄 Re-scan inbox for missed bids'; }
}

chips(); draw();
</script>
</body>
</html>
